<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AfterTheCredits</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AfterTheCredits.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md site-navigation">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">After the Credits</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-navigation" aria-controls="site-navigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="site-navigation" class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav me-md-3">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Watchlist">My Movies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Recommendations">Recommendations</a></li>
                    </ul>
                    <form method="post" asp-page="/ResetDemo" class="mb-0"
                          onsubmit="return confirm('Clear your watchlist, watched movies and ratings for this demo?');">
                        <button type="submit" class="btn btn-sm btn-outline-light">Reset Demo</button>
                    </form>
                </div>
                }
                else
                {
                    <a class="nav-link" asp-page="/Privacy">Privacy Policy</a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="site-main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-links">
                <span>&copy; @DateTime.UtcNow.Year After the Credits</span>
                <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
            </div>
            <section class="footer-credits" aria-label="Data source credits">
                <a class="footer-tmdb" href="https://www.themoviedb.org/">
                    <img src="~/tmdb-logo.svg" asp-append-version="true"
                         alt="The Movie Database (TMDB)" width="116" height="15" />
                </a>
                <p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
                <p>Viewing availability powered by <a href="https://www.justwatch.com/ie">JustWatch</a> via TMDB.</p>
            </section>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
