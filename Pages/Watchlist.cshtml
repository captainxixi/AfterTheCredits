@page
@using System.Globalization
@model AfterTheCredits.Pages.WatchlistModel
@{
    ViewData["Title"] = "My Movies";
}

<link rel="stylesheet" href="~/css/watchlist.css" asp-append-version="true" />

<h1>My Movies</h1>

<nav class="watchlist-tabs" aria-label="My movies">
    <a class="watchlist-tab @(!Model.Watched ? "watchlist-tab--active" : "")"
       aria-current="@(!Model.Watched ? "page" : null)"
       asp-page="/Watchlist" asp-route-watched="false">Watchlist (@Model.WatchlistCount)</a>
    <a class="watchlist-tab @(Model.Watched ? "watchlist-tab--active" : "")"
       aria-current="@(Model.Watched ? "page" : null)"
       asp-page="/Watchlist" asp-route-watched="true">Watched (@Model.WatchedCount)</a>
</nav>

@if (Model.Watched && Model.TopGenres.Count > 0)
{
    <p class="watchlist-genres">
        <strong>Favorite genres</strong>
        <span>@string.Join(" · ", Model.TopGenres)</span>
    </p>
}
@if (!Model.VisibleMovies.Any())
{
    @if (Model.Watched)
    {
        <p>You haven't marked any movies as watched yet. <a asp-page="/Watchlist" asp-route-watched="false">View your watchlist</a></p>
    }
    else
    {
        <p>Your watchlist is empty. <a asp-page="/Index">Find a movie</a></p>
    }
}
else
{
    <ul class="watchlist-grid" role="list">
        @foreach (var movie in Model.VisibleMovies)
        {
            var ratingId = $"watchlist-rating-{movie.Id}";
            <li class="watchlist-card">
                <div class="watchlist-movie">
                    <a class="watchlist-movie-link" asp-page="/MovieDetails" asp-route-id="@movie.Id">
                        @if (!string.IsNullOrEmpty(movie.PosterPath))
                        {
                            <img class="watchlist-poster" src="https://image.tmdb.org/t/p/w200@(movie.PosterPath)"
                                 alt="" width="80" height="120" loading="lazy" />
                        }
                        <h2>@movie.Title</h2>
                    </a>
                    <p class="watchlist-meta">TMDB @movie.Rating.ToString("F1")</p>
                    @if (movie.Genres.Count > 0)
                    {
                        <p class="watchlist-meta">@string.Join(" · ", movie.Genres.Select(genre => genre.Name))</p>
                    }
                    <span class="watchlist-status @(movie.IsWatched ? "watchlist-status--watched" : "")">
                        @(movie.IsWatched ? "Watched" : "Not watched")
                    </span>
                </div>

                <div class="watchlist-actions">
                    <form method="post" asp-page-handler="SaveRating" asp-route-watched="@Model.Watched" class="watchlist-rating">
                        <input type="hidden" name="movieId" value="@movie.Id" />
                        <label for="@ratingId">My rating</label>
                        <input class="form-control form-control-sm" id="@ratingId" name="myRating" type="number"
                               min="0" max="10" step="0.5" value="@(movie.MyRating?.ToString(CultureInfo.InvariantCulture))" required />
                        <button class="btn btn-sm btn-primary" type="submit">@(movie.IsWatched ? "Save" : "Save & mark watched")</button>
                    </form>
                    <div class="watchlist-buttons">
                        <form method="post" asp-page-handler="ToggleWatched" asp-route-watched="@Model.Watched">
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                @(movie.IsWatched ? "Mark as not watched" : "Mark as watched")
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Remove" asp-route-watched="@Model.Watched"
                              onsubmit="return confirm('Remove this movie from My Movies?');">
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <button class="btn btn-sm btn-link text-danger" type="submit">Remove</button>
                        </form>
                    </div>
                </div>
            </li>
        }
    </ul>
}
